      --sheet <NAME>
          Title of the sheet to modify

      --freeze-rows <N>
          Rows to freeze at the top of the grid; 0 unfreezes

      --freeze-columns <N>
          Columns to freeze at the left of the grid; 0 unfreezes

      --tab-color <HEX>
